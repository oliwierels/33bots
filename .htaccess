RewriteEngine On

# HTTPS und non-www (kanonische Adresse: https://33bots.de)
#
# ACHTUNG: hier stand bis 2026-09 eine unveränderte Kopie der polnischen Datei. Die Regel
# leitete jeden Aufruf ohne HTTPS auf https://33bots.pl/... um — also auf eine fremde Domain.
# Für Google sah 33bots.de damit wie eine Weiterleitung auf die polnische Seite aus, was
# eine Indexierung der deutschen Seiten von vornherein ausschloss.
RewriteCond %{HTTP_HOST} ^www\.33bots\.de$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://33bots.de/$1 [L,R=301]

# Die Startseite hat genau eine Adresse: / , nicht /index.html. Sonst sieht ein Crawler
# zwei Seiten mit identischem Titel und Google wählt selbst, welche er zeigt.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://33bots.de/ [L,R=301]

ErrorDocument 404 /404.html

# Der Zustandsbericht des Deployments gehört niemandem außer uns.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Cache-Politik für statische Dateien
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

<IfModule mod_headers.c>
  # HSTS: nach dem ersten Besuch erzwingt der Browser selbst HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  # Kein Einbetten der Seite in fremde Frames (Clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Browser-APIs abschalten, die die Seite nicht braucht.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  # CSP nennt genau die Hosts, von denen die Seite wirklich etwas lädt. Die Analytik
  # ist hier abgeschaltet (GTM_ID leer), Schriften liegen lokal — deshalb ist die
  # Liste kürzer als auf 33bots.pl. 'unsafe-inline' bleibt: Skripte und Styles stehen
  # in den Seiten selbst.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com; font-src 'self' data:; connect-src 'self' https://formspree.io; frame-src https://www.googletagmanager.com; media-src 'self'; form-action 'self' https://formspree.io; base-uri 'self'; frame-ancestors 'self'"
</IfModule>

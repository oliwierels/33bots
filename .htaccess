RewriteEngine On

# ── Własna strona błędu 404 ───────────────────────────────────────────────────
# Bez tej linii serwer oddawał domyślną stronę hostingu („Error 404 Nie
# znaleziono strony”) zamiast 404.html z nawigacją do oferty.
ErrorDocument 404 /404.html

# Force HTTPS and non-www (canonical: https://33bots.pl)
RewriteCond %{HTTP_HOST} ^www\.33bots\.pl$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://33bots.pl/$1 [L,R=301]

# Konsolidacja stron miejskich aglomeracji śląskiej do Katowic
# (odpowiednik reguł z _redirects, który działa tylko na Netlify)
Redirect 301 /robot-wynajem-bytom.html            /robot-wynajem-katowice.html
Redirect 301 /robot-wynajem-chorzow.html          /robot-wynajem-katowice.html
Redirect 301 /robot-wynajem-dabrowa-gornicza.html /robot-wynajem-katowice.html
Redirect 301 /robot-wynajem-jaworzno.html         /robot-wynajem-katowice.html
Redirect 301 /robot-wynajem-sosnowiec.html        /robot-wynajem-katowice.html
Redirect 301 /robot-wynajem-tychy.html            /robot-wynajem-katowice.html
Redirect 301 /robot-wynajem-zabrze.html           /robot-wynajem-katowice.html

# ── Wycofana strona zbiorcza oferty ───────────────────────────────────────────
# /oferta.html była cienkim rozdzielaczem do podstron ofertowych i została
# usunięta z serwisu. Adres jest zaindeksowany i ma odnośniki z zewnątrz,
# więc zamiast 404 kieruje tam, gdzie prowadziła większość jej kafelków.
Redirect 301 /oferta.html                         /wypozyczenie-robota.html

# ── Cienki wpis bloga scalony z poradnikiem ───────────────────────────────────
# „Atrakcja na event firmowy — robot vs inne opcje” (618 słów) wszedł jako
# rozdział do poradnika „Atrakcje na imprezę firmową”.
Redirect 301 /blog-atrakcja-na-event-firmowy.html /atrakcje-na-impreze-firmowa.html

# ── Pliki ukryte (zaczynające się kropką) ─────────────────────────────────────
# Paczka wdrożeniowa zawiera np. .mcp.json (konfiguracja narzędzi analitycznych
# Claude — bez sekretów). Nie ma powodu, by serwer je podawał; wyjątek:
# .well-known (certyfikaty SSL, weryfikacje domen).
RedirectMatch 404 "/\.(?!well-known/)"

# ── Kanoniczny adres strony głównej ────────────────────────────────────────────
# /index.html i / to ta sama treść pod dwoma adresami. Crawler widzi wtedy dwie
# strony z identycznym tytułem, a Google sam wybiera, którą pokazać.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://33bots.pl/ [L,R=301]

# ── Publiczne API i serwer MCP (api/index.php) ───────────────────────────────
# /api/ — opis, /api/wycena — orientacyjna cena, /api/zapytania — zapytanie o termin,
# /mcp — serwer MCP dla asystentów AI. Pliki statyczne w /api/ (openapi.json) idą wprost.
RewriteRule ^api/?$ api/index.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/([a-z0-9-]+)/?$ api/index.php?zasob=$1 [L,QSA]
RewriteRule ^mcp/?$ api/index.php?zasob=mcp [L,QSA]

# ── Źródła i testy nie są częścią serwisu ─────────────────────────────────────
# Paczka wdrożeniowa zawiera katalogi ze źródłami treści i testami. Serwer nie ma ich
# podawać: to surowe fragmenty stron (także w innych językach), których wyszukiwarka
# nie powinna znaleźć pod tą domeną.
RedirectMatch 404 "^/(tresci|qa|badania|seo)/"

# ── Dane robota 3D na stronie głównej (robot/*.bin) ───────────────────────────
# Chmura punktów dla js/robot3d.js. Kompresja zmniejsza plik o ok. 10–30%, a adres
# ma sumę kontrolną (?v=), więc przeglądarka może go trzymać długo.
<FilesMatch "\.bin$">
  <IfModule mod_mime.c>
    ForceType application/octet-stream
  </IfModule>
  <IfModule mod_deflate.c>
    SetOutputFilter DEFLATE
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=2592000"
  </IfModule>
</FilesMatch>

# ── Nagłówki bezpieczeństwa ────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # HSTS: po pierwszej wizycie przeglądarka sama wymusza HTTPS i nie pozwala
  # obniżyć połączenia. Bez preload — to decyzja jednokierunkowa, trudna do cofnięcia.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Zakaz zgadywania typu pliku — blokuje atak polegający na podsunięciu skryptu
  # jako obrazka.
  Header always set X-Content-Type-Options "nosniff"

  # Zakaz osadzania strony w cudzej ramce (podszywanie się, clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"

  # Do obcych serwisów wysyłamy samą domenę, nie pełny adres podstrony.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Wyłączamy API przeglądarki, z których strona nie korzysta.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

  # CSP wymienia dokładnie te hosty, z których strona faktycznie korzysta:
  # GTM i Albacross (analityka), Formspree (formularz), Google Fonts, TVP (wideo)
  # oraz hosty, do których wysyłają dane tagi doładowywane przez GTM-MR7R7CJ3:
  # Google Analytics 4 i Google Ads (konwersje, remarketing), a także piksel Albacross.
  # Bez nich polityka po cichu blokuje cały pomiar — strona działa, statystyki stoją.
  # 'unsafe-inline' jest konieczny, bo skrypty i style są osadzone w stronie —
  # usunięcie go wymagałoby przebudowy szablonów, a nie samej konfiguracji serwera.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://consentboard.com https://*.consentboard.com https://www.googletagmanager.com https://serve.albacross.com https://*.albacross.com https://www.googleadservices.com https://www.google.com https://googleads.g.doubleclick.net https://*.clarity.ms https://c.bing.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://consentboard.com https://*.consentboard.com; img-src 'self' data: https://consentboard.com https://*.consentboard.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.google.com https://www.google.pl https://www.google.at https://www.google.de https://*.doubleclick.net https://www.googleadservices.com https://*.albacross.com https://*.clarity.ms https://c.bing.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://formspree.io https://consentboard.com https://*.consentboard.com https://www.google-analytics.com https://*.albacross.com https://serve.albacross.com https://www.googletagmanager.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://www.google.com https://www.google.pl https://www.google.at https://www.google.de https://*.doubleclick.net https://www.googleadservices.com https://pagead2.googlesyndication.com https://*.clarity.ms https://c.bing.com; frame-src https://consentboard.com https://*.consentboard.com https://www.googletagmanager.com https://gdansk.tvp.pl https://www.youtube.com https://www.youtube-nocookie.com https://*.doubleclick.net; media-src 'self'; form-action 'self' https://formspree.io; base-uri 'self'; frame-ancestors 'self'"
</IfModule>
